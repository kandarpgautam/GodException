<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>GodException</PackageId>
		<Version>1.0.0</Version>
		<Authors>Kandy</Authors>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- Include the repository README.md (located at solution root) in the package root
		 Use a relative path to reference the file outside the project folder. -->
	<ItemGroup>
	  <None Include="..\README.md" Pack="true" PackagePath="" Visible="true" />
	</ItemGroup>

</Project>
